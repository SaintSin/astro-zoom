---
// pages/index.astro
import AstroZoom from "@components/AstroZoom.astro";
import image1 from "@images/panda-01.jpg";
import Layout from "@layouts/BaseLayout.astro";

const meta = {
	title: "astro-zoom demo",
	description: "A zoom component for Astro",
	imageOG: "generic-social-1200x630.png",
	altOG: "Alt text for OG image",
};
---

<Layout metaData={meta}>
  <main class="wrapper flow">
    <h1>astro-zoom</h1>
    <p>Click any image to zoom. Click the backdrop or press Escape to close.</p>

    <h2>Single image</h2>
    <AstroZoom
      src={image1}
      alt="Panda"
      thumbnailWidth={800}
      caption="Giant panda"
      modalCaption="The giant panda (Ailuropoda melanoleuca) is a bear native to south central China, classified as a vulnerable species."
    />

    <h2>Grid</h2>
    <div class="grid" data-layout="thirds">
      <AstroZoom src={image1} alt="Panda" caption="A giant panda in its natural habitat" />
      <AstroZoom src={image1} alt="Panda" />
      <AstroZoom src={image1} alt="Panda" />
    </div>
  </main>
</Layout>

<style>
  .az-trigger img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
